# Converts the normative CSV tables of the spec into a C++ header (configure time).
# Each table becomes `inline constexpr double <name>[][<columns>]` with one row per data line.
# Comment lines (#) and the column-header line are skipped, empty cells become NaN, band letters A..E become 0..4.

function (enhancer_embed_tables outHeader)
    set (body "// Generated by plugins/enhancer/cmake/EmbedTables.cmake from spec/enhancer/r1/tables - do not edit.\n")
    string (APPEND body "#pragma once\n\n#include <cstddef>\n#include <limits>\n\nnamespace craft::enhancer::tables\n{\n\n")
    string (APPEND body "inline constexpr double nan = std::numeric_limits<double>::quiet_NaN();\n\n")

    foreach (csv IN LISTS ARGN)
        get_filename_component (name ${csv} NAME_WE)
        set_property (DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${csv})
        file (STRINGS ${csv} lines)
        set (rows "")
        set (header TRUE)
        set (columns 0)
        set (rowCount 0)
        set (columnNames "")
        foreach (line IN LISTS lines)
            string (STRIP "${line}" line)
            if (line STREQUAL "" OR line MATCHES "^#")
                continue()
            endif()
            if (header)
                set (header FALSE)
                set (columnNames "${line}")
                continue()
            endif()
            # make empty cells explicit
            string (REGEX REPLACE "^," "N," line "${line}")
            string (REPLACE ",," ",N," line "${line}")
            string (REPLACE ",," ",N," line "${line}")
            string (REGEX REPLACE ",$" ",N" line "${line}")
            string (REPLACE "," ";" cells "${line}")
            set (out "")
            set (n 0)
            foreach (cell IN LISTS cells)
                if (cell STREQUAL "N")
                    set (v "nan")
                elseif (cell MATCHES "^[A-E]$")
                    string (FIND "ABCDE" "${cell}" v)
                else()
                    set (v "${cell}")
                endif()
                if (n GREATER 0)
                    string (APPEND out ", ")
                endif()
                string (APPEND out "${v}")
                math (EXPR n "${n} + 1")
            endforeach()
            if (columns EQUAL 0)
                set (columns ${n})
            elseif (NOT columns EQUAL n)
                message (FATAL_ERROR "${csv}: inconsistent column count in line '${line}'")
            endif()
            string (APPEND rows "    { ${out} },\n")
            math (EXPR rowCount "${rowCount} + 1")
        endforeach()
        string (APPEND body "// ${name}.csv: ${columnNames}\n")
        string (APPEND body "inline constexpr std::size_t ${name}_rows = ${rowCount};\n")
        string (APPEND body "inline constexpr std::size_t ${name}_cols = ${columns};\n")
        string (APPEND body "inline constexpr double ${name}[${rowCount}][${columns}] = {\n${rows}};\n\n")
    endforeach()

    string (APPEND body "} // namespace craft::enhancer::tables\n")
    # only rewrite when changed (keeps incremental builds incremental)
    if (EXISTS ${outHeader})
        file (READ ${outHeader} old)
        if (old STREQUAL body)
            return()
        endif()
    endif()
    file (WRITE ${outHeader} "${body}")
endfunction()
