# Embeds the normative spec tables (CSV) into a generated C++ header, so the plug-in and the tests never read
# files at run time. Each CSV becomes an array of its lines:  inline constexpr const char* <name>[] = { ... };
#
# fet_limiter_embed_tables (<output header> <name>=<csv path> ...)
function (fet_limiter_embed_tables outHeader)
    set (body "// Generated by plugins/fet-limiter/cmake/EmbedTables.cmake from spec/fet-limiter/r1/tables - do not edit.\n")
    string (APPEND body "#pragma once\n\n#include <cstddef>\n\nnamespace craft::fet_limiter::spec_tables\n{\n")
    foreach (entry IN LISTS ARGN)
        string (REPLACE "=" ";" parts "${entry}")
        list (GET parts 0 name)
        list (GET parts 1 csvPath)
        set_property (DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${csvPath}")
        file (STRINGS "${csvPath}" lines)
        string (APPEND body "inline constexpr const char* ${name}[] = {\n")
        foreach (line IN LISTS lines)
            string (REPLACE "\\" "\\\\" line "${line}")
            string (REPLACE "\"" "\\\"" line "${line}")
            string (STRIP "${line}" line)
            if (NOT line STREQUAL "")
                string (APPEND body "    \"${line}\",\n")
            endif()
        endforeach()
        string (APPEND body "};\ninline constexpr std::size_t ${name}Size = sizeof (${name}) / sizeof (${name}[0]);\n\n")
    endforeach()
    string (APPEND body "} // namespace craft::fet_limiter::spec_tables\n")
    # only rewrite when the content changes (keeps incremental builds incremental)
    if (EXISTS "${outHeader}")
        file (READ "${outHeader}" old)
    else()
        set (old "")
    endif()
    if (NOT old STREQUAL body)
        file (WRITE "${outHeader}" "${body}")
    endif()
endfunction()
